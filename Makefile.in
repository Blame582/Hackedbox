src/main.$(OBJEXT): src/$(am__dirstamp) src/$(DEPDIR)/$(am__dirstamp)

hackedbox$(EXEEXT): $(hackedbox_OBJECTS) $(hackedbox_DEPENDENCIES) $(EXTRA_hackedbox_DEPENDENCIES) 
	@rm -f hackedbox$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(hackedbox_OBJECTS) $(hackedbox_LDADD) $(LIBS)
src/hbsetbg-HbSetBg.$(OBJEXT): src/$(am__dirstamp) \
	src/$(DEPDIR)/$(am__dirstamp)

hbsetbg$(EXEEXT): $(hbsetbg_OBJECTS) $(hbsetbg_DEPENDENCIES) $(EXTRA_hbsetbg_DEPENDENCIES) 
	@rm -f hbsetbg$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(hbsetbg_OBJECTS) $(hbsetbg_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f src/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

