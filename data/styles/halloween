root.background: ~/.hackedbox/backgrounds/halloween/default1.jpg
root.background.mode: center
# Background folder for automatic image rotation
#root.background.folder: ~/.hackedbox/backgrounds/halloween
# Background rotation timer in minutes (0 = disabled)
#root.background.timer: 5

menu.title.font: Hack-14
menu.title: raised gradient diagonal
menu.title.color: #4A4A4A
menu.title.colorTo: #181818
menu.title.textColor: #FF8C1A
menu.title.justify: center
menu.title.alpha: 255

menu.frame.font: Hack-13
menu.frame: sunken gradient diagonal
menu.frame.color: #181818
menu.frame.colorTo: #333333
menu.frame.textColor: #FF8C1A
menu.frame.justify: center
menu.frame.alpha: 255

menu.hilite: raised gradient diagonal
menu.hilite.color: #CC5500
menu.hilite.colorTo: #663300
menu.hilite.textColor: #FFFFFF
menu.hilite.alpha: 255

menu.clock.font: Hack-13
menu.clock.textColor: #CC5500
menu.clock.format: %I:%M:%S %p
menu.clock.justify: center

menu.date.font: Hack-13
menu.date.textColor: #CC5500
menu.date.format: %m/%d/%Y
menu.date.justify: center

menu.bullet: triangle
menu.bullet.position: right

menu.icon: true
menu.icon.position: left
menu.icon.alpha: 255

