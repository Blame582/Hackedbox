root.background:                    /usr/share/hackedbox/backgrounds/default.jpg
root.background.mode:                center
# Background folder for automatic image rotation
#root.background.folder:             ~/.hackedbox/backgrounds
# Background rotation timer in seconds (0 = disabled)
#root.background.timer:              0

menu.frame.font:                     Hack-12
menu.frame:                           flat gradient crossdiagonal
menu.frame.color:                    #D5D5D5
menu.frame.colorTo:                  #B4B4B4
menu.frame.textColor:                #343434
menu.frame.justify:                  right
menu.frame.disableColor:             #FFFFFF
menu.frame.alpha:                    255

menu.title.font:                     Hack-14
menu.title:                           flat gradient vertical
menu.title.color:                    #8E8E8E
menu.title.colorTo:                  #5F5F5F
menu.title.textColor:                #C8C8C8
menu.title.justify:                  center
menu.title.alpha:                    255

menu.hilite:                          flat gradient vertical
menu.hilite.color:                   #3B90DC
menu.hilite.colorTo:                 #2C5F8C
menu.hilite.textColor:               #8EFDFF
menu.hilite.alpha:                   255

menu.clock.font:                     Hack-12
menu.clock.textColor:                #343434
menu.clock.format:                   %I:%M:%S %p
menu.clock.justify:                  right

menu.date.font:                      Hack-12
menu.date.textColor:                 #343434
menu.date.format:                    %m/%d/%Y
menu.date.justify:                   right

menu.bullet:                          triangle
menu.bullet.position:                 right

menu.icon:                            true
menu.icon.position:                   right
