#!/bin/sh

HACKEDBOX_HOME="$HOME/.hackedbox"
STARTUP_DIR="$HACKEDBOX_HOME/startup"

if [ -d "$STARTUP_DIR" ] && find "$STARTUP_DIR" -maxdepth 1 -type f -name '*.run' -print -quit | grep -q .; then
    for startup in "$STARTUP_DIR"/*.run; do
        [ -f "$startup" ] || continue
        [ -x "$startup" ] || continue
        "$startup" &
    done
fi

exec hackedbox