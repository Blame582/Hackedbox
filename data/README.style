menu.clock.textColor: #AEB8C2
menu.clock.format: %I:%M:%S %p
menu.clock.justify: center

menu.date.font: Hack-13
menu.date.textColor: #AEB8C2
menu.date.format: %m/%d/%Y
menu.date.justify: center

menu.bullet: triangle
menu.bullet.position: right

menu.icon: true
menu.icon.position: left

window.title.focus: raised gradient vertical
window.title.focus.color: #505458
window.title.focus.colorTo: #1E2226

window.title.unfocus: raised gradient vertical
window.title.unfocus.color: #32363A
window.title.unfocus.colorTo: #000000

window.label.focus: sunken diagonal gradient
window.label.focus.color: #0A141E
window.label.focus.colorTo: #46505A
window.label.focus.textColor: #FFFFFF

window.label.unfocus: sunken diagonal gradient
window.label.unfocus.color: #000000
window.label.unfocus.colorTo: #28323C
window.label.unfocus.textColor: #3C4044

window.button.focus: raised gradient diagonal
window.button.focus.color: #5A5E62
window.button.focus.colorTo: #14181C
